# --- app ---
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173

# --- database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bs_sms
POSTGRES_USER=bs_sms
POSTGRES_PASSWORD=bs_sms
# POSTGRES_USER owns the tables and runs the migrations.
# DB_APP_ROLE is the NON-superuser, NON-owner role the app connects as, and the
# one row-level security actually applies to. Keep them different.
DB_APP_ROLE=bs_app
DB_APP_PASSWORD=bs_app

# --- redis / celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- identity: this service is the OIDC issuer ---
JWT_ISSUER=https://sms.beyondschools.co.tz
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- AI Beyond Schools ---
AI_PLATFORM_BASE_URL=https://aibeyondschools.co.tz/api
AI_PLATFORM_API_KEY=
AI_PLATFORM_WEBHOOK_SECRET=

# --- payments (one aggregator behind the PaymentProvider protocol) ---
PAYMENT_PROVIDER=mock          # mock | selcom | azampay | clickpesa
PAYMENT_WEBHOOK_SECRET=
SELCOM_VENDOR_ID=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_BASE_URL=https://apigwtest.selcommobile.com
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_BASE_URL=https://sandbox.azampay.co.tz

# --- sms ---
SMS_PROVIDER=mock          # mock | beem
SMS_SENDER_ID=BEYONDSCH
SMS_API_KEY=
SMS_API_SECRET=
