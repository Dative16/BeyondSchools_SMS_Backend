__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.sqlite3
.DS_Store

# A TLS-intercepting network's root CA, used for builds on one machine only.
docker/local-ca.pem

# The local signing keypair. Production keys come from the platform's secret
# store; a key in git is a key that has to be rotated.
secrets/

# Generated from the running app by `make openapi`, consumed by the web repo.
# A stale copy in git is worse than no copy.
openapi.json

# Provider credentials and reference material kept beside the project.
# Secrets belong in .env (which is already ignored), never in a file that a
# `git add -A` could sweep up.
beam settings.txt
*settings.txt
*.cs.txt

# Documents written by the local storage adapter.
.storage/
