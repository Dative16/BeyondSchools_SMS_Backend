__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.sqlite3
.DS_Store

# A TLS-intercepting network's root CA, used for builds on one machine only.
docker/local-ca.pem

# The local signing keypair. Production keys come from the platform's secret
# store; a key in git is a key that has to be rotated.
secrets/

# openapi.json is generated by `make openapi` and *is* committed. It used to be
# ignored, on the grounds that a stale copy in git is worse than no copy — but
# the web repo generates its TypeScript from it, so "no copy" meant the client
# had nothing to check itself against, and CI had nothing to compare a fresh
# dump with. The freshness check in CI is what makes the committed copy safe:
# a route added without re-dumping fails the build.

# Provider credentials and reference material kept beside the project.
# Secrets belong in .env (which is already ignored), never in a file that a
# `git add -A` could sweep up.
beam settings.txt
*settings.txt
*.cs.txt

# Documents written by the local storage adapter.
.storage/
